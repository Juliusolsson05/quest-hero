# Copy to .env and fill in. .env is gitignored.
# The model provider key can instead be pasted straight into the TrueForge UI
# (Settings -> Models), which keeps it out of the filesystem entirely.
OPENAI_API_KEY=
BRIGHT_DATA_API_TOKEN=
TRUEFORGE_BASE_URL=http://localhost:8790
# Tripo (asset generation, tools/tripo.mjs) — tcli_/tsk_ key from platform.tripo3d.ai
TRIPO_API_KEY=

# hub/.env — World Hub extras (all optional, all fail-soft):
# GITHUB_TOKEN=      `gh auth token` — needed while the repo is private (commit → crate)
# TRUEFORGE_MODEL=   force a model FQN; empty = first configured model in TrueForge
# WEATHER_LAT/LON=   defaults to San Francisco
# SUPABASE_PROJECT_REF= project whose public.users table gets a row per join,
#                       written via TrueForge's supabase MCP connector (auth in
#                       the TrueForge UI). Empty disables the registrar.
